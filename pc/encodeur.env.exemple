# Copier en « .env » à côté de encodeur.yml (dossier C:\transhumance), puis compléter.

# Adresse de Transhumance sur le NAS (réseau local)
TRANSHUMANCE_URL=http://192.0.2.10:8097

# Jeton de l'encodeur : même valeur que TRANSHUMANCE_JETON_CALCUL dans la stack homelab
TRANSHUMANCE_JETON_CALCUL=

# Fils de calcul de ffmpeg : « auto » (tous les cœurs) ou un nombre pour laisser le PC respirer
THREADS=auto
