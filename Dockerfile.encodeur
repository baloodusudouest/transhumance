# syntax=docker/dockerfile:1
# 0.10.0 : encodeur des vidéos pour le PC (Docker Desktop). Image ghcr.io/baloodusudouest/transhumance:encodeur.
FROM python:3.12-slim-bookworm
LABEL org.opencontainers.image.title="transhumance-encodeur" \
      org.opencontainers.image.description="Réencode sur le PC les vidéos que Transhumance lui confie" \
      org.opencontainers.image.source="https://github.com/baloodusudouest/transhumance"
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tzdata && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir httpx==0.28.1 \
    && useradd --create-home --uid 1000 encodeur && mkdir -p /travail && chown encodeur /travail
WORKDIR /app
COPY app/__init__.py app/video.py app/encodeur.py ./app/
ENV TZ=Europe/Paris PYTHONUNBUFFERED=1 TRAVAIL=/travail
USER encodeur
CMD ["python", "-m", "app.encodeur"]
